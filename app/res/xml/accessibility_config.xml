<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración del modo "cubrir barras del sistema".
  - Sin accessibilityEventTypes: Android no le envía ningún evento (no sabe qué apps abres ni qué escribes).
  - canRetrieveWindowContent="false": no puede leer el contenido de la pantalla.
  - Sin canPerformGestures: no puede tocar por ti.
  Lo único que usa es el derecho a dibujar una capa por encima de la barra de estado y del panel.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/a11y_description"
    android:summary="@string/a11y_summary"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
