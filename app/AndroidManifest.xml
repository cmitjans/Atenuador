<?xml version="1.0" encoding="utf-8"?>
<!--
  Atenuador: oscurece la pantalla por debajo del brillo mínimo.
  Permisos (la lista completa; no hay ningún otro):
  - SYSTEM_ALERT_WINDOW: dibujar la capa oscura sobre las demás apps (lo apruebas tú en Ajustes).
  - FOREGROUND_SERVICE y FOREGROUND_SERVICE_SPECIAL_USE: mantener la capa activa mientras usas otras apps.
  - POST_NOTIFICATIONS: mostrar el aviso "Atenuador activo" con el botón para apagarlo.
  No pide INTERNET, así que Android no le permite conectarse a nada.

  Modo opcional "cubrir barras del sistema": un servicio de accesibilidad que tú activas en
  Ajustes → Accesibilidad. No es un permiso que la app pida; está configurado para no leer la
  pantalla ni recibir eventos (ver res/xml/accessibility_config.xml).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cl.cmitjans.atenuador">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Atenuador"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mantener presionado el botón de ajustes rápidos abre este panel pequeño de intensidad -->
        <activity
            android:name=".PanelIntensidad"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".DimService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Capa oscura sobre la pantalla para bajar el brillo por debajo del mínimo" />
        </service>

        <service
            android:name=".DimTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Atenuador"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DimAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
